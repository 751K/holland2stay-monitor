# ══════════════════════════════════════════════════════════════════════
# FlatRadar 多平台租房监控 — 系统配置
#
# 用户级配置（通知渠道、过滤条件、自动预订）统一在 Web 面板管理：
#   python web.py  →  浏览器打开 http://localhost:8088  →  「用户」页面
#
# 本文件只包含系统/全局设置，复制后按需修改即可。
#
# ── 先看这里：真正需要你填的没几个 ──────────────────────────────────
#
# 下面所有**已注释掉**的键都有代码默认值，可以一个都不管。第一次部署实际要填的
# 只有这些：
#
#   必填    WEB_PASSWORD          不填 Docker entrypoint 会拒绝启动
#   生产必填 HTTPS_PROXY           机房 IP 抓 H2S 会被 Cloudflare 403
#   生产必填 PUBLIC_BASE_URL       否则验证邮件里的链接指向内网 host
#   按需    RESEND_* / APNS_* / FCM_*   想用哪些通知渠道
#
# 监控哪些城市和平台、多久抓一次——**这些不在本文件里改**，见下面的 runtime 说明。
#
# 键名打错不会报错，只会安静地走默认值。monitor 启动时会审计一遍并对不认识的
# 键发 WARNING（含「是不是想写 X」的提示），日志里搜 "⚙️  .env" 即可。
#
# ── 四类配置 ─────────────────────────────────────────────────────────
#
# 全部键名及其类别登记在 env_registry.py，那里是唯一的权威清单：
#
#   secret   凭据。永远留在这个文件里，不进数据库（库会被备份/导出）、不进日志
#   deploy   部署事实（路径、时区、对外基址）。换机器或换域名才改；且部分要在
#            能读数据库之前就可用，例如 DB_PATH
#   runtime  运维调参与监控范围。**已迁往 SQLite 的 app_settings 表，由 Web 面板
#            管理**，见下方说明
#   tuning   行为阈值与开关。全都有默认值，绝大多数部署一个都不用填
#
# ── runtime 类已经不住在这里了 ───────────────────────────────────────
#
# 轮询节奏（CHECK_INTERVAL / PEAK_* / MIN_INTERVAL / JITTER_RATIO /
# HEARTBEAT_INTERVAL_MINUTES / LOG_LEVEL）与监控范围（SOURCES / CITIES /
# *_CITIES / AVAILABILITY_FILTERS / SHADOW_SOURCES / SHARD_SIZES /
# SOURCE_MIN_INTERVALS）自 v1.16.0 起存在数据库里，**在 Web 面板「设置」页改**。
# 首次启动会自动把它们从本文件搬进数据库（搬之前整份备份为 .env.bak.<时间戳>）。
#
# 下面仍保留这些键的注释，是为了说明它们的含义与取值格式；**取消注释会覆盖面板**
# ——环境变量的优先级高于数据库。这是留给容器化排障的强制口子
# （docker compose run -e CHECK_INTERVAL=30 ...），面板会显示「被环境变量覆盖」，
# monitor 启动时也会 WARNING。日常改配置请用面板。
# ══════════════════════════════════════════════════════════════════════

# ── Web 面板鉴权 ─────────────────────────────────────────────────────
# 鉴权由 WEB_PASSWORD 启用：留空则任何人均可访问面板，设置后必须先登录。
# WEB_USERNAME 留空时，**用户名为 admin**。
# ⚠️ 生产环境务必设置 WEB_PASSWORD，否则面板将无密码公开。
#    密码为空时 Docker entrypoint 会拒绝启动；本地试运行可使用
#    docker-compose.local.yml 跳过该检查，该覆盖层仅将端口发布到回环地址。
WEB_USERNAME=
WEB_PASSWORD=

# 访客模式：true=登录页显示「访客模式」按钮（只读，无需密码），false=关闭
WEB_GUEST_MODE=true

# 公开支持页显示的联系邮箱。生产环境请改成你实际能收信的地址。
SUPPORT_EMAIL=support@example.com

# Flask session 密钥（首次启动自动生成并写入，也可手动指定）
# 固定值可在重启后保留已登录状态；留空则每次重启自动生成（会强制退出所有登录）
FLASK_SECRET=

# Session Cookie 安全设置
# HTTPS 部署（VPS + Caddy）时设为 true，本地开发保持 false
SESSION_COOKIE_SECURE=false
# Session 有效期（小时），默认 24 小时
SESSION_LIFETIME_HOURS=24

# ── 共享邮件服务（Resend） ───────────────────────────────────────────
# 启用后，用户在通知设置里选「使用 FlatRadar 邮件服务」即可只填收件邮箱，
# 不需要自己折腾 SMTP。三项都填齐才算开启；任意一项缺失视为关闭。
#
# 申请：https://resend.com → 免费档 3000/月 + 100/天
# 步骤：1) 注册 → 2) 在 dashboard 添加自己的域名 → 3) 按提示加 DNS 记录
#       4) 域名验证后即可拿 API key（以 re_ 开头）
#
# RESEND_FROM 必须是 Resend 已验证域名下的邮箱，否则 API 直接 403。
SHARED_EMAIL_ENABLED=true
RESEND_API_KEY=
RESEND_FROM=notify@example.com

# 公开的 Web 基址，用于在验证邮件里生成可点击的链接。
# 生产环境必填（否则邮件里的链接会用本地内网 host）。
# 例：PUBLIC_BASE_URL=https://flatradar.example.com
PUBLIC_BASE_URL=

# Resend 每日配额（防免费档 100/天被打爆）。默认对齐免费档的 80% buffer。
# 计数已落 SQLite (email_send_counters)，多 Gunicorn worker 共享，重启不丢。
RESEND_GLOBAL_DAILY_LIMIT=80
RESEND_PER_USER_DAILY_LIMIT=20

# ── Resend Inbound Email webhook ───────────────────────────────────
# 接收入站邮件需要的 Svix 签名 secret（Resend dashboard 创建 webhook
# 后给一个 ``whsec_<base64>`` 串，复制过来）。
#
# 设置后 /api/inbound/email 才会接受请求；空值或不匹配的请求一律 401。
# 同时还会用 RESEND_API_KEY 反查邮件正文（webhook payload 只送元数据）。
RESEND_WEBHOOK_SECRET=

# 入站邮件转发目标邮箱（可选）
# 收到 notify@ 的入站邮件后，自动转发到该地址；DMARC 报告不转发。
# 例：INBOUND_FORWARD_TO=you@gmail.com
INBOUND_FORWARD_TO=

# ── DMARC 加固升级（非环境变量，纯文档） ────────────────────────────
# 域名初次跑通时 DMARC 策略是 p=none（仅监控）。
# 在域名稳定发邮件 2-4 周、确认 SPF/DKIM 通过率 ≥99% 后，建议升级：
#
#   1. p=quarantine — 冒充邮件进收件方垃圾箱（推荐第二阶段）
#       _dmarc TXT: v=DMARC1; p=quarantine; rua=mailto:dmarc@yourdomain
#   2. p=reject     — 冒充邮件直接退回（最严格，量大企业才需要）
#       _dmarc TXT: v=DMARC1; p=reject; rua=mailto:dmarc@yourdomain
#
# 升级前在 Resend dashboard 查 "Bounces / Complaints" 趋势，确认没有大量
# DKIM 失败（说明 DNS 没问题）。p=quarantine 永远不会让你的合法邮件被
# 完全退回，只是更严格地走 spam 路径，回滚到 p=none 也是 30s DNS 修改。

# ── APNs（iOS 推送） ──────────────────────────────────────────────────
# 如需启用，设置 APNS_ENABLED=true 并填写以下四项。
# .p8 文件从 Apple Developer → Keys 下载；Team ID 在 Membership 里找。
#
# APNS_ENABLED=true
# APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=com.j.kong.FlatRadar
# APNS_ENV_DEFAULT=sandbox
# APNS_CONCURRENCY=16

# ── FCM（Android 推送） ───────────────────────────────────────────────
# 如需启用，设置 FCM_ENABLED=true。
# 推荐方式：从 Firebase Console → Project Settings → Service accounts
# 下载 service account JSON 文件，复用项目原有的 crypto 库对私钥完成 OAuth2
# 签名（零额外依赖）。
#
# 方式一：service account JSON（推荐）
#   FCM_ENABLED=true
#   FCM_SERVICE_ACCOUNT_PATH=/path/to/service-account-key.json
#
# 方式二：环境变量逐项填写（Docker / 不方便挂文件时）
#   FCM_ENABLED=true
#   FCM_PROJECT_ID=flatradar-66342
#   FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@flatradar-66342.iam.gserviceaccount.com
#   FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
#
# FCM_CONCURRENCY=16
# FCM_REQUEST_TIMEOUT=10

# ── 监控全局配置 ──────────────────────────────────────────────────────
# 普通轮询间隔（秒），默认 5 分钟；高峰期间隔在 Web 面板「设置」中调整
# CHECK_INTERVAL=300

# /health 判定 monitor 健康的心跳容许停滞秒数，默认 900（15 分钟 ≈ 3–4 轮）。
# monitor 每轮开始时刷新心跳（与抓取成败无关，熔断冷却期也照常刷新）；
# 超过此值 /health 返回 503，Docker 把容器标为 unhealthy。
# 调大 = 容忍更长的主动暂停；调小 = 更快发现监控停摆。
# MONITOR_HEARTBEAT_MAX_AGE=900

# ── 分轮抓取 ─────────────────────────────────────────────────────────
#
# 格式 source:每轮最多几个 target，逗号分隔。target 数超过它时本轮只抓一个
# 切片，游标存在 SQLite 里逐轮轮转，若干轮覆盖一遍全部；值 >= 实际 target 数
# 时自动失效，写 0 表示关闭该 source 的分片。
#
# 默认 xior:4。只有它需要——限流按速率算，Xior 的请求间隔被定在 5s
# （调小会直接撞回 429，见 XIOR.md §2.2），实测**每栋楼 13.9 秒**，而其余三个
# source 每 target 只要 1–4 秒。官方注册表 30 栋 ≈ 417 秒/轮，超过
# CHECK_INTERVAL；而且 H2S 排在其它 source 之后执行，不分片等于每轮把真正
# 出房源的那个 source 推迟 7 分钟。4 栋 ≈ 56 秒。
# SHARD_SIZES=xior:4

# ── 单 source 最小抓取间隔 ───────────────────────────────────────────
#
# 格式 source:秒数，逗号分隔。默认 xior:180。写 0 关掉该 source 的节流。
#
# ⚠️ 它与上方的分片**解决的并非同一问题**：分片控制「每轮抓取多少个 target」，
# 而本项控制「同一个 target 多久抓取一次」。将两者混同的后果曾经实测过——
# Xior 楼栋数从 30 缩减至 4 之后，分片形同虚设（每轮全部抓取），而高峰轮次间隔
# 仅 60–90 秒，单栋楼的请求频率因此上升约一个数量级，直接触发限流：持续 429、
# 退避 30s+60s，单轮耗时从 40 秒延长至 270 秒。
#
# **楼栋数减少反而更易触发限流**，因为限流按「同一 target 被请求的频率」计算，
# 而非按总请求量——30 栋轮换抓取时每栋自然稀疏，4 栋轮换则全部挤在一起。
# 实测结论：每栋 5 分钟或 10 分钟一次均未触发 429，60–90 秒一次则会失败。
# 请勿直接设为 0。
# SOURCE_MIN_INTERVALS=xior:180

# 高峰期专用的最小间隔（秒）。缺项的 source 回落到上面那份。
#
# 这道闸门**只在高峰期真正起作用**：非高峰的轮次间隔本身就是 CHECK_INTERVAL
# （300 秒起，加抖动实测中位 381 秒），比 180 秒的闸门还慢；高峰期轮次是
# PEAK_INTERVAL 60 秒、自适应还会衰减到 MIN_INTERVAL 20 秒，闸门成为唯一
# 给 Xior 减速的机制。
#
# 2026-08-14–21 七天实测（窗口 07:30–11:00 / 13:30–17:00，仅工作日）：
#
#   高峰期，180 秒闸门   轮间隔中位 202 秒   每轮 429 概率 12.44%   51 次
#   非高峰，闸门不生效   轮间隔中位 381 秒   每轮 429 概率  0.09%    1 次
#
# 节奏相差不到 2 倍，429 概率相差 138 倍——180 秒正压在阈值边缘，380 秒在安全
# 侧，98% 的 429 出在高峰那 7 小时里。故高峰期取 360 秒，贴近实测安全值。
#
# 注意方向与 PEAK_INTERVAL 相反：那个是高峰期**加快**轮次，这个是高峰期
# **放慢**单个 source——正因为轮次加快了才需要它。
# SOURCE_PEAK_MIN_INTERVALS=xior:360

# ── 数据健康告警（/monitoring 面板 + admin 推送）──────────────────────
#
# 上面的 /health 只回答「循环还活着吗」。下面这组回答「数据还对吗」——
# 进程活着、心跳正常，但解析器被上游改版打坏、或某个 source 一直"成功"
# 返回 0 条，/health 是绿的，这组阈值才看得见。判据详见 ARCHITECTURE §5.12。

# 判定窗口：每个 source 回看多少轮。默认 24 轮（5 分钟一轮 ≈ 2 小时）。
# HEALTH_WINDOW_ROUNDS=24

# 连续失败几轮判为 down。默认 3 轮 ≈ 15 分钟，够长到不被一次网络抖动触发。
# HEALTH_FAIL_STREAK_DOWN=3

# 连续抓到 0 条几轮判为 warn。**还要求该 source 在窗口内曾抓到过房源**——
# Xior / OurCampus 常态零可订，没有这个前提它们会被永久钉在告警上。
# HEALTH_ZERO_STREAK_WARN=3

# 距上次完整扫描超过多少秒判为 warn。默认 5400（90 分钟）。
# 不完整的轮次不做 stale 收敛，已下架房源会一直挂着——多久没有完整轮，
# 下架判定就滞后多久，量的正是这个后果。
#
# 这条取代了旧的 HEALTH_COMPLETENESS_WARN（完整扫描率阈值）：H2S 的分层抓取
# 让高频轮一律 complete=False，完整率结构性地停在 10% 上下，按比率报会天天响。
# HEALTH_STALE_FULL_SCAN_SECONDS=5400

# 同一条告警的最小重发间隔（秒），默认 21600（6 小时）。
# 退化类故障不像异常那样自己会好，报得太勤只会让人开始忽略它。
# 节流状态存在 SQLite 而不是内存——进程重启后仍然生效。
# WATCHDOG_REPEAT_INTERVAL=21600

# 全站静默多少秒才报（库里仍有房源的前提下）。
# 判据是**时间**不是轮数：高峰期一轮 60 秒、峰外 390 秒，同样几轮可以差六倍；
# 而「全站 0 条」本来就是常态——H2S 高频轮只查可订、OurCampus 三个月 1 条、
# Xior 常态零可订。按轮数算高峰期六分钟就报一次（2026-08-25 实测报了两次，
# 两次都是正常状态）。
# 默认 3 小时 ≈ 连着漏掉 6 次 H2S 全量轮。
# HEALTH_SILENT_SECONDS=10800

# ── 房源状态收敛 ─────────────────────────────────────────────────────
#
# 四个平台均不提供「房源已下架」的显式信号，只是停止返回该房源，因此「消失时长」
# 是唯一可用的判据。但**「消失」意味着什么，取决于 feed 覆盖了哪些状态**
# （详见 ARCHITECTURE §5.13）：
#
#   feed 未覆盖「已预留」（Xior / OurDomain / OurCampus，以及未抓 6203 的 H2S）：
#     消失有歧义 —— 可能被下单了，也可能彻底没了
#     可订 / 抽签 / Unknown --消失 0.5h--> Reserved(推测) --消失 2h--> Occupied
#
#   feed 已覆盖「已预留」（AVAILABILITY_FILTERS 含 6203 的 H2S）：
#     消失无歧义 —— 已掉出全部被跟踪的状态
#     可订 / 抽签 --消失 2h--> Occupied
#
# 前一种情况下中间态系有意保留：「未再出现」足以支持不再显示为可订，但不足以断言
# 「已出租」。落在 Reserved 上判错的代价低得多——Reserved -> 可订 本就是常见迁移；
# 若直接判定终态而房源随后回归，则会向一批用户推送失实的「重新上架」通知。
# 后一种情况下这个顾虑不存在：平台已经如实上报了 Reserved，无需再推测一次。
# 推断得出的状态在面板上带有「推测」徽标，API 中对应 status_is_inferred。
#
# 收敛**仅对本轮完整扫描成功的城市**执行，抓取失败不会被读作「房源已下架」。
# 推测转换不写入 status_changes，因此不产生任何通知。

# 消失多久推定为 Reserved（小时）。默认 0.5。
# 仅对 feed 未覆盖「已预留」的 source 生效。
# STALE_RESERVED_HOURS=0.5

# 消失多久判定为 Occupied（小时）。默认 2——**该值对齐 Holland2Stay 官方的付款
# 限时**：消失超过该时长的预留，其结果必然已经确定（或已付款，或已作废并以可订
# 状态重新出现）。两个值均夹取到 [0.25, 720] 小时；若 OCCUPIED 小于 RESERVED，
# 将自动取齐至 RESERVED 并记 WARNING，否则第二段会先于第一段生效，中间态失去意义。
# STALE_OCCUPIED_HOURS=2

# 智能轮询高峰时段：
#   窗口① 早间 — 荷兰时间 8:30-10:00（新房源上架最集中时段）
#   窗口② 下午 — 荷兰时间 13:30-15:00（下午工作时间）
#   以下配置可在 Web 面板「设置 → 智能轮询」中直接修改，无需手动编辑
# PEAK_INTERVAL=60
# MIN_INTERVAL=15
# PEAK_START=08:30
# PEAK_END=10:00
# PEAK_START_2=13:30
# PEAK_END_2=15:00
# PEAK_WEEKDAYS_ONLY=true
# JITTER_RATIO=0.20

# 心跳通知间隔（分钟），默认 60（1 小时）；设为 0 禁用心跳
# HEARTBEAT_INTERVAL_MINUTES=60

# 数据加密密钥（首次启动自动生成并写入，也可手动指定 32 字节 base64）
# ⚠️ 更换此密钥后所有已加密的敏感字段（用户密码、token）将无法解密
# DATA_ENCRYPTION_KEY=

# 目标城市，格式: "城市名,ID"，多个用 | 分隔
# 建议在 Web 面板「设置 → 目标城市」中选择，无需手动填写 ID
# 完整城市列表见 config.py → KNOWN_CITIES（26 个城市）
# SOURCES=holland2stay
# CITIES=Eindhoven,29

# OurDomain 监控（可选）：启用时设 SOURCES=holland2stay,ourdomain
# 格式: "显示名,key"，多个用 | 分隔
# OURDOMAIN_CITIES=Amsterdam Diemen,diemen

# 空结果要连着看到几轮才算数（对 OurDomain 和 OurCampus 都生效）。默认 3。
#
# RentCafe 在「确无可订单元」与「响应结构异常」两种情况下返回的页面几乎一致，
# 均为 HTTP 200 加一张完整的搜索结果面板。而这两栋楼的可订单元长期维持在个位数，
# 「真实的 0」与「异常的 0」在单轮内不具备可分性，一次误判即足以收敛整栋楼。
# 因此要求连续 N 轮均为 0 才允许其参与 stale 收敛；未达计数时房源照常入库，仅
# 本轮不参与。一旦解析出任意单元，计数立即清零。取值夹取到 [1, 20]。
#
# 代价是真实空楼的收敛推迟 N-1 轮（默认约 10 分钟）。Holland2Stay 与 Xior 无需
# 该守卫：前者可用 total_pages 自证结构完整，后者可用 errorCode 自证上游调用成功。
# OURDOMAIN_ZERO_ROUNDS_TO_CONFIRM=3

# OurDomain / OurCampus 的 TLS 指纹池，逗号或 | 分隔（curl_cffi 的
# impersonate 名字，如 chrome124,safari17_0）。留空用内置默认池。
# SecureRC 的 403 属 WAF 级拦截，更换指纹即可通过；该池即用于轮换。被拒的指纹会
# 进入冷却，后续优先选取最近成功过的指纹。通常无需修改。
# OURDOMAIN_IMPERSONATES=

# 撞上 WAF 时最多换几个指纹重试。默认 4，即只取指纹池的前 4 个；内置池共 8 个，
# 设为 8 可用满。调大提高单轮通过率，代价是失败时该 target 的耗时成倍增加。
# OURDOMAIN_WAF_RETRIES=4

# OurCampus 监控（可选）：启用时把 ourcampus 加进 SOURCES
# 与 OurDomain 同属 Greystar、同一套 RentCafe 后端。只有一栋楼（Diemen），
# 且官网自述等待期 16–18 个月（排队制），实时通知的价值有限——按需开启。
# OURCAMPUS_CITIES=OurCampus Amsterdam Diemen,diemen
# 抓取留档（可选）：每次请求记一行摘要，有单元/疑似解析失配时附完整 HTML。
# 默认 data/ourcampus_capture.txt，写满 8MB 后停止。
# OURCAMPUS_CAPTURE_PATH=data/ourcampus_capture.txt

# 影子 source（可选）：列出的平台照常抓取入库，但**不发任何通知**
# （用户渠道 + 面板 feed + APNs/FCM 全部跳过）。用于新平台上线前的静默验证。
# 必须是 SOURCES 的子集；留空 = 所有平台都正常通知。
# SHADOW_SOURCES=ourcampus

# Xior 监控（可选）：启用时设 SOURCES=holland2stay,ourdomain,xior
# 格式: "显示名,key"，多个用 | 分隔。留空则默认荷兰 30 栋全开。
# key 即 building_code（如 p0196467），完整列表见 config.py → KNOWN_XIOR_CITIES
# XIOR_CITIES=Eindhoven Kronehoefstraat,p0196467|Eindhoven Zernikestraat,p0195855

# 抓取哪些可用状态。Holland2Stay 的 available_to_book 共六个取值：
#   179   Direct te boeken         直接可订
#   336   Beschikbaar in loterij   抽签中
#   6203  Reserved                 已下单未付款
#   6204  To be in lottery         即将进入抽签（还不能报名）
#   180   Niet beschikbaar         不可用
#   6253  Coming soon              即将上线
#
# 加上 6203 之后，「已预留」由平台如实上报，不再靠「消失 30 分钟」推测——
# 状态收敛会相应改为「消失即判终态」（见 ARCHITECTURE §5.13）。去掉它则退回
# 两段式推测，行为自动跟着配置走。
#
# 不建议抓 180：它是整个存量池（租出、未上架、已下架全归这一档，且不区分原因），
# 仅两个城市就有两千多条，是其余状态总量的几十倍。
# AVAILABILITY_FILTERS=Available to book,179|Available in lottery,336|Reserved,6203

# CloakBrowser 是否 headless。默认 true；macOS 本地会自动降级为 headed
# （headless v145 有 SIGABRT 风险），Linux 生产保持 true。
# CLOAKBROWSER_HEADLESS=true

# ── 抓取代理（绕 Cloudflare / 拿荷兰住宅 IP）─────────────────────────
# 机房 IP 抓 H2S 会被 Cloudflare 403，需住宅/移动代理。
#   主代理：HTTPS_PROXY（也兼容 HTTP_PROXY / ALL_PROXY）
#   备用代理：SCRAPE_PROXIES_FALLBACK，逗号分隔多个——主代理挂了（如 webshare
#            502 / X-Webshare-Error）连续确认服务端异常后自动切到备用，
#            故障代理冷却 10 分钟后重新纳入。
#   若所有代理都连续确认服务端异常并进入冷却，抓取会临时直连服务器原生 IP，并自动降频到最多 10 分钟一次。
#
#   冷却时长分两档（2026-08-26 加）：
#     瞬时故障（502 / 503 / 隧道抖动）        10 分钟，可能自己好，值得早点回去试
#     账户级（402 欠费 / 407 认证失败）        PROXY_ACCOUNT_COOLDOWN_SEC，默认 1 小时
#   账户级故障不会自己好，10 分钟一到就把死代理放回候选等于每小时自伤六次——
#   webshare 两个账号同时 402 那天，Xior 和 OurCampus 每 10 分钟各丢一轮。
#   充值之后想立刻恢复就重启进程：冷却状态是进程级的，重启即清零。
# 例：
#   HTTPS_PROXY=http://user:pass@p.webshare.io:80
#   SCRAPE_PROXIES_FALLBACK=http://user:pass@backup1.proxy:8080,http://user:pass@backup2.proxy:8080
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=
# SCRAPE_PROXIES_FALLBACK=
# PROXY_ACCOUNT_COOLDOWN_SEC=3600
#
# ── 自己的线路（可选）──────────────────────────────────────────────
# SCRAPE_PROXIES_PERSONAL 列出池子里哪些代理是「自家宽带」而不是买来的商业池。
# 典型做法是家里一台常开的机器拉一条反向 SSH 隧道到服务器：
#     ssh -N -R 172.19.0.1:1080 <server>        # 远程动态转发 = SOCKS5
# 然后把 socks5://172.19.0.1:1080 追加到 SCRAPE_PROXIES_FALLBACK **末尾**
# （排最后 = 商业代理都挂了才会用到），并在这里登记为个人线路。
#
# 登记之后会**主动降速**：轮次间隔抬到 PERSONAL_PROXY_MIN_INTERVAL（默认 120 秒）。
# 理由是商业池的出口烧了换一个就是，自家 IP 烧了没得换，而且影响家里所有上网。
# 这和「代理全挂降级直连」是两回事：那个是被迫，这个是主动保护。
#
# 值要和 SCRAPE_PROXIES_FALLBACK 里那条一致（比对时只看 scheme/host/port，
# 忽略用户名里的 session 段和密码）。
#   SCRAPE_PROXIES_PERSONAL=socks5://172.19.0.1:1080
#   PERSONAL_PROXY_MIN_INTERVAL=120
# SCRAPE_PROXIES_PERSONAL=
# PERSONAL_PROXY_MIN_INTERVAL=120
#
# ⚠️ Python 的 urllib 会**无差别地**将上述三个代理变量应用于所有请求，包括
#    localhost 的健康检查——代理拒绝连接 localhost 将返回 403，导致容器被标记为
#    unhealthy。docker-compose.yml 中已设置 NO_PROXY=localhost,127.0.0.1,::1
#    以规避该问题；在容器外手工执行脚本时需自行注意。

# 浏览器是否拦截与房源数据无关的子请求（图片、字体、统计与广告脚本）。
# 默认开启。代理按流量计费，而浏览器为了过 Cloudflare 挑战会把整张页面连同
# 这些资源一并下载；实测该部分约占每日流量的 10%，与抓取结果无关。
# 若怀疑拦截导致 Cloudflare 挑战通过率下降，设为 0 可退回原样，无需改代码。
# BROWSER_BLOCK_RESOURCES=1

# 浏览器是否统计每次会话的真实下行字节数。默认开启。
# 走 CDP 的 Network.loadingFinished.encodedDataLength——Chromium 自己记的线上
# 字节数，不额外产生请求、不把响应体拉进内存。日志里与拦截数同行输出，并附带
# 磁盘缓存命中数，用于验证 BROWSER_PERSIST_PROFILE 是否真的省到了流量。
# 仅 Chromium 内核可用；装不上时静默降级，不影响抓取。
# BROWSER_BYTE_ACCOUNTING=1

# 浏览器是否复用磁盘上的 profile（data/browser_profiles/）。默认开启。
# Cloudflare 的挑战载荷占每日代理流量的一半以上，成因是每次重建浏览器都是
# 全新的空缓存；复用 profile 后这部分改为命中磁盘缓存。实测单次导航
# 3.93MB → 0.25MB。cookie 每次启动均清空，不跨会话沿用。
# 该目录会占用磁盘（每槽位上限 128MB），删除后自动重建，仅损失一次冷启动。
# BROWSER_PERSIST_PROFILE=1

# ── 自动预订 ─────────────────────────────────────────────────────────
# 是否给某个用户开自动预订、用哪个账号，都在 Web 面板的用户表单里配。
# 这里只有两个全局项。
#
# ⚠️ 当前仅 Holland2Stay 实际可用（见 monitor._AUTO_BOOK_SOURCES）。
#    RENTCafe 线（Xior / OurDomain / OurCampus）代码已完整但未启用，
#    欠缺的是端到端验证，见 ARCHITECTURE §7.1。

# 2Captcha API key，用于解 RENTCafe 的 reCAPTCHA（约 $0.003–0.005/次）。
# 仅 RENTCafe 线需要；Holland2Stay 使用的是 Cloudflare Turnstile，不依赖该项。
# 未设置时，RENTCafe 预订将在验证码环节失败并记 WARNING。
# CAPTCHA_API_KEY=

# 自动预订下单成功后，本地将状态保持为 Reserved 的时长（分钟）。默认 120，对齐
# Holland2Stay 的付款限时。上游 feed 未必立即反映刚提交的订单，若不保持则会被
# 下一轮的「可订」覆盖，并额外产生一条失实的重新上架通知。
# BOOKING_STATUS_HOLD_MINUTES=120

# ── 路径与外部服务 ───────────────────────────────────────────────────

# 数据库文件路径
DB_PATH=data/listings.db

# 数据目录（日志、抓取留档、证件暂存等），默认为仓库下的 data/。
# Docker 部署请勿修改：compose 按 ./data:/app/data 挂载。
# DATA_DIR=data

# 地图页使用的 Google Maps JS API key。
# ⚠️ 留空时 /map 页面**不可用**：该页将显示「未配置 GOOGLE_MAPS_API_KEY」而非
# 地图，且不存在无需 key 的降级底图。列表 / 日历 / 图表均不受影响。
# 申请方式：Google Cloud Console → 启用 Maps JavaScript API → 创建 API key。
# GOOGLE_MAPS_API_KEY=

# 日志级别：DEBUG / INFO / WARNING
# LOG_LEVEL=INFO

# Flask 调试模式。仅本地开发；生产开启会暴露交互式调试器（可在服务器上执行代码）。
# 只影响 `python web.py` 直接运行的情况，gunicorn 不读它。
# FLASK_DEBUG=false

# supervisord 配置文件路径，面板的「重启 monitor」按钮据此调 supervisorctl。
# 默认 /etc/supervisor/conf.d/app.conf，与镜像内的位置一致；非容器部署才需要改。
# SUPERVISOR_CONF=/etc/supervisor/conf.d/app.conf

# 时区（IANA 标识符），用于图表日期分组和智能轮询时段判断
# Docker 容器默认 UTC，建议显式设为荷兰时区
TIMEZONE=Europe/Amsterdam
